# Copy this file to .env and customize the values for your machine.
PORT=3000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
DB_PATH=data/shop.sqlite
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=my_shop_vip
UPI_ID=your-upi-id@bank
PAYMENT_QR_IMAGE=/payment-qr.png
SHOP_NAME=My Shop VIP
LEGAL_NAME=Your legal business name
STORE_ADDRESS=Metapal, Dantewada, Chhattisgarh, India
CONTACT_PHONE=+91-your-shop-phone
CONTACT_EMAIL=you@example.com
GRIEVANCE_CONTACT=Name, Customer Grievance Officer
