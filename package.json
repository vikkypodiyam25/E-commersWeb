{
  "name": "my-shop-vip",
  "version": "1.0.0",
  "private": true,
  "description": "A small local storefront with a SQLite cart and checkout backend.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning backend/server.js",
    "dev": "node scripts/run-local.js",
    "backend": "node --disable-warning=ExperimentalWarning backend/server.js",
    "backend:dev": "node --watch --disable-warning=ExperimentalWarning backend/server.js",
    "frontend": "node scripts/frontend-server.js",
    "dev:frontend": "node scripts/frontend-server.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "mongodb": "^7.9.1"
  }
}
